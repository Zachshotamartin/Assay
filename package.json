{
  "name": "assay-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Implementation in progress for the Assay local-first agent evaluation harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zachshotamartin/Assay.git"
  },
  "homepage": "https://github.com/Zachshotamartin/Assay#readme",
  "bugs": {
    "url": "https://github.com/Zachshotamartin/Assay/issues"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean:build": "node scripts/clean-build.mjs",
    "build": "npm run clean:build && tsc -b --force --pretty false && node esbuild.config.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --noEmit --pretty false",
    "test": "vitest run --workspace vitest.workspace.ts --passWithNoTests",
    "test:unit": "vitest run --workspace vitest.workspace.ts --exclude '**/*.property.test.ts' --exclude '**/test/integration/**' --exclude 'tests/e2e/**' --exclude 'scripts/r1-reproducibility.test.ts' --passWithNoTests",
    "test:property": "vitest run --workspace vitest.workspace.ts .property.test.ts --passWithNoTests",
    "test:integration": "vitest run --workspace vitest.workspace.ts test/integration --passWithNoTests",
    "test:store": "vitest run --workspace vitest.workspace.ts packages/run-store/test/integration --passWithNoTests",
    "test:e2e:simulated": "vitest run --workspace vitest.workspace.ts tests/e2e scripts/r1-reproducibility.test.ts --passWithNoTests",
    "test:reproducibility": "vitest run --workspace vitest.workspace.ts scripts/r1-reproducibility.test.ts",
    "fixtures:regen": "node --import tsx scripts/fixture-regeneration.ts",
    "fixtures:manifest": "node --import tsx scripts/fixture-governance.ts refresh",
    "regenerate-goldens": "npm run fixtures:regen -- fixtures/goldens",
    "check:fixtures": "node --import tsx scripts/fixture-governance.ts check",
    "check:goldens": "node --import tsx scripts/golden-policy.ts check",
    "check:test-evidence": "node --import tsx scripts/check-test-evidence.ts",
    "lint:architecture": "node --import tsx scripts/check-architecture.ts",
    "lint:docs": "node --import tsx scripts/check-docs.ts",
    "check:architecture": "npm run lint:architecture",
    "check:docs": "npm run lint:docs",
    "lint": "npm run lint:docs && npm run lint:architecture && npm run check:test-evidence",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
