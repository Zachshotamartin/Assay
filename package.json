{
  "name": "assay-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Implementation in progress for the Assay local-first agent evaluation harness.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run --workspace vitest.workspace.ts --passWithNoTests",
    "test:unit": "vitest run --workspace vitest.workspace.ts --passWithNoTests",
    "test:property": "vitest run --workspace vitest.workspace.ts --passWithNoTests",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
