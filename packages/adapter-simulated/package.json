{
  "name": "@assay/adapter-simulated",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic scripted assay-adapter/1 subprocess.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zachshotamartin/Assay.git"
  },
