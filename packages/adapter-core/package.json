{
  "name": "@assay/adapter-core",
  "version": "0.0.0",
  "private": true,
  "description": "assay-adapter/1 wire contract and subprocess supervisor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zachshotamartin/Assay.git"
