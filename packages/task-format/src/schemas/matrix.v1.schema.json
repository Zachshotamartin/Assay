{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.assay.dev/matrix/1.0.json",
  "title": "Assay matrix format 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "task", "axes"],
  "properties": {
    "format_version": { "const": "1.0" },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/).+\\.task\\.yaml$"
    },
    "axes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ]
        }
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ]
        }
      }
    }
  }
}
