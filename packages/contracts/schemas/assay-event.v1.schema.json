{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://assay.dev/schemas/assay-event.v1.schema.json",
  "title": "AssayEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "run_id", "timestamp", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "type": {
      "enum": [
        "RunPlanned",
        "FixtureMaterialized",
        "SandboxStarted",
        "AdapterHandshake",
        "ModelRequestStarted",
        "ModelResponseRecorded",
        "ToolCallRecorded",
        "UsageReconciled",
        "UsageUnreconciled",
        "WorkspaceSnapshotTaken",
        "AssertionEvaluated",
        "JudgeVoteRecorded",
        "TrajectoryScored",
        "BudgetEvaluated",
        "TaskRunCompleted",
        "SandboxDestroyed",
        "SuiteCompleted",
        "ComparisonCompleted",
        "RunFailed",
        "RunCancelled"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "task_run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "FixtureMaterialized",
              "SandboxStarted",
              "AdapterHandshake",
              "ModelRequestStarted",
              "ModelResponseRecorded",
              "ToolCallRecorded",
              "UsageReconciled",
              "UsageUnreconciled",
              "WorkspaceSnapshotTaken",
              "AssertionEvaluated",
              "JudgeVoteRecorded",
              "TrajectoryScored",
              "BudgetEvaluated",
              "TaskRunCompleted",
              "SandboxDestroyed"
            ]
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": { "task_run_id": true },
        "required": ["task_run_id"]
      },
      "else": { "not": { "required": ["task_run_id"] } }
    }
  ]
}
